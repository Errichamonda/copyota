<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:padding="20dp">
  <TextView android:id="@+id/badge" android:layout_width="48dp" android:layout_height="48dp"
      android:gravity="center" android:textSize="20sp" android:textFontWeight="800"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:layout_marginStart="16dp" android:orientation="vertical">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="20sp" android:textFontWeight="700"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:baselineAligned="false" android:gravity="center_vertical">
      <TextView android:id="@+id/text" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textSize="15sp"/>
      <!-- The padding leaves room for the blur, the negative margins cancel it out so the host sits inline. -->
      <TextView android:id="@+id/link" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:layout_marginStart="-8dp" android:layout_marginTop="-12dp" android:layout_marginBottom="-12dp"
          android:padding="12dp" android:visibility="gone" android:textSize="15sp" android:textFontWeight="700"/>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
